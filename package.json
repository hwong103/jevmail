{
  "name": "jevmail",
  "version": "0.1.0",
  "description": "Self-hostable Gmail triage with Jev classification",
  "scripts": {
    "test": "npm run check:migrations && vitest run",
    "dev": "vite",
    "build": "vite build && node scripts/deploy.mjs --clean-dist && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test:db": "node scripts/check-migrations.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:raw": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.3",
    "hono": "4.13.20",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.166.0"
  },
  "typecheck": "tsc --noEmit",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "allowScripts": {
    "workerd@1.20261119.1": true,
    "workerd@1.20261117.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
