{
  // Public template. This file must stay generic: no installation-specific
  // account IDs, database IDs, or owner addresses. Deployers generate their own.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jevmail",
  "main": "src/worker.ts",
  // Pinned to the newest date the bundled workerd supports. Raising it requires
  // bumping workerd first; the deploy and the test pool must agree.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Workers AI. The classify job runs Cloudflare's `typesafe/jev` model through
  // this binding; without it a classify job parks as blocked_auth rather than
  // guessing. This binding stays here so deploys are complete.
  //
  // Workers AI has no local simulator, so `@cloudflare/vitest-pool-workers`
  // would otherwise treat this binding as remote and open a remote proxy
  // session requiring CLOUDFLARE_API_TOKEN — breaking credential-free CI.
  // `vitest.config.ts` sets the pool's documented `remoteBindings: false` to
  // opt out; adding `remote: true` here would defeat that. Local tests never
  // call this binding, so they stay credential-free. Exercising live AI from
  // local dev needs credentials via `wrangler dev --remote` (or a deploy).
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      // Bound by name. A deploy script resolves the real ID per installation.
      "binding": "DB",
      "database_name": "jevmail",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOB_QUEUE",
        "queue": "jevmail-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "jevmail-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        // Seconds between redeliveries. Must exceed JOB_LEASE_MS (120s) in
        // src/server/jobs/consumer.ts, or a retry that loses the claim to a
        // crashed winner's live lease can burn all retries and dead-letter the
        // job before the lease expires, stranding it.
        "retry_delay": 130,
        "dead_letter_queue": "jevmail-jobs-dlq"
      }
    ]
  },
  "triggers": {
    // Polling path. Push notifications are deliberately deferred; see PLAN-v2.
    "crons": ["*/7 * * * *"]
  },
  "vars": {
    // Optional escape hatch. Unset by default: whoever signs in first binds the
    // installation. Setting it pre-pins the principal and rejects other logins.
    // OWNER_EMAIL: "you@example.com",
    // Optional. Only the literal "fixture" is honoured: it swaps in the
    // deterministic local classifier instead of Workers AI. Any other value (or
    // unset) uses the AI binding above.
    // JEV_PROVIDER: "fixture"
  }
}
