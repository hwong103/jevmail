# Copy to .dev.vars for local development. Never commit a filled-in copy.

# Google OAuth client. Redirect URI must match exactly what the app prints.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-side only. Never exposed to a browser.
SESSION_SECRET=

# Base64url 32-byte key for AES-GCM credential encryption. Rotatable.
CREDENTIAL_KEY=
CREDENTIAL_KEY_VERSION=1

# Classifier selection. Workers AI (the `AI` binding in wrangler.jsonc) is the
# default. Two optional overrides:
#
# 1. Command Code Provider API. Setting a key selects it over Workers AI. The
#    endpoint is https://api.commandcode.ai/provider/v1/systemone.
# JEV_API_KEY=
# CMD_API_KEY=
# JEV_BASE_URL=https://api.commandcode.ai
#
# 2. Deterministic local fixture. `fixture` wins over both a key and the AI
#    binding; use it to run without a provider account.
# JEV_PROVIDER=fixture
